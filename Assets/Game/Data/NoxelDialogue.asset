  m_Script: {fileID: 11500000, guid: 301488d2b276e174dbf7676171176482, type: 3}
  m_Name: NoxelDialogue
  m_EditorClassIdentifier: Assembly-CSharp::BrokenHeart.Systems.NoxelDialogueData
  calmLines:
  - A lovely place to forget who you are.
  - Build your little shelter. I enjoy watching.
  - Everything here remembers you. How awkward.
  distressedLines:
  - Don't turn around. I'm joking. Mostly.
  - Those eyes? Perhaps you should sleep.
  - You call them shadows. How polite.
